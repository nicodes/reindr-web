---
import octicons from '@primer/octicons';
import Layout from '../layouts/Layout.astro';

const repo = 'https://github.com/nicodes/reindr';
const docs = `${repo}#readme`;
const npmPackage = 'https://www.npmjs.com/package/@nicodes/reindr-opencode';
const icon = (name: keyof typeof octicons, size = 16) =>
	octicons[name].toSVG({ width: size, height: size });
---

<Layout
	title="reindr - Generative interfaces for agent sessions"
	description="Give OpenCode and Claude Code sessions an editable HTML canvas. Reindr handles live reload, sandboxing, session routing, and browser-to-agent interactions."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="reindr home">
				<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
					<path class="mark-shell" d="M16 3 28 10v12L16 29 4 22V10L16 3Z"></path>
					<path class="mark-lines" d="M10 10v6l-4-3m4 1L7 8m15 2v6l4-3m-4 1 3-6M10 16c0 7 12 7 12 0m-8 5h4"></path>
				</svg>
				<span>reindr</span>
			</a>
			<a class="header-cta" href={repo}>GitHub <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Available now / v0.0.1</p>
					<h1>Give the agent a canvas. <em>Work in what it builds.</em></h1>
					<p class="lede">
						Reindr gives OpenCode and Claude Code sessions an editable HTML file and a live browser panel.
						The agent writes the interface with ordinary tools; Reindr takes care of the reload,
						the sandbox, and the route back to the session.
					</p>
					<div class="hero-actions">
						<a class="primary-cta" href="#install">Install Reindr <span class="icon" set:html={icon('arrow-right', 16)} /></a>
						<p>OpenCode + Claude Code / Chromium</p>
					</div>
				</div>

				<div class="hero-demo" data-demo data-state="initial" data-phase="idle">
					<div class="product-frame" role="group" aria-labelledby="demo-title">
						<div class="frame-bar">
							<div class="frame-brand"><span class="menu-lines"></span> reindr / release-check</div>
							<div class="frame-actions"><span class="live-dot"></span><b>live</b><span class="icon" set:html={icon('screen-full', 13)} /></div>
						</div>
						<div class="workspace">
							<aside class="session-rail" aria-label="Session examples">
								<p>SESSIONS</p>
								<div class="session active"><i></i><span><b>Release check</b><small>build</small></span></div>
								<div class="session"><i></i><span><b>API refactor</b><small>plan</small></span></div>
								<div class="session"><i></i><span><b>Schema review</b><small>build</small></span></div>
							</aside>
							<div class="canvas">
								<div class="canvas-bar"><span>release-gate.html</span><span data-demo-updated>waiting for a prompt</span></div>
								<div class="build-trace" aria-hidden="true">
									<span><i></i> agent editing</span>
									<code data-demo-patch>+ .failed &lbrace; border-left: 3px solid #d8665d; &rbrace;</code>
								</div>
								<div class="dashboard">
									<div class="dashboard-head">
										<div><small>RELEASE GATE / MAIN</small><h2 id="demo-title" data-demo-title>Ready when the red is gone.</h2></div>
										<button type="button" data-panel-action>Ask agent to fix</button>
									</div>
									<div class="filter-bar" data-filter-bar hidden>
										<span>ENVIRONMENT</span>
										<button type="button" data-environment="all" aria-pressed="false">All</button>
										<button type="button" data-environment="production" aria-pressed="true">Production</button>
									</div>
									<div class="metrics">
										<div><small>PASSED</small><strong data-metric="passed">47</strong><i class="good"></i></div>
										<div><small>FAILED</small><strong data-metric="failed">2</strong><i class="bad"></i></div>
										<div><small>DURATION</small><strong data-metric="duration">8.4s</strong><i></i></div>
									</div>
									<div class="test-list">
										<div data-test="0" data-environment-row="production"><span class="check good"></span><b>core / session routing</b><code>1.2s</code></div>
										<div data-test="1" data-environment-row="production"><span class="check good"></span><b>browser / live reload</b><code>2.8s</code></div>
										<div class="failed" data-test="2" data-environment-row="production"><span class="check bad"></span><b>security / stale capability</b><code>42ms</code></div>
										<div class="failed" data-test="3" data-environment-row="staging"><span class="check bad"></span><b>controller / queue wakeup</b><code>19ms</code></div>
									</div>
									<div class="agent-note"><span class="icon" set:html={icon('sparkles-fill', 14)} /><p><b data-note-title>Send to agent</b><span data-note-copy>Fix the two failing tests, then rerun this dashboard.</span></p><span class="icon arrow" set:html={icon('arrow-up', 14)} /></div>
								</div>
							</div>
						</div>
					</div>
					<div class="demo-controls" aria-label="Interactive Reindr demonstration">
						<div class="prompt-list">
							<span>TRY A PROMPT</span>
							<button type="button" data-prompt="highlight" aria-pressed="false">Highlight blockers</button>
							<button type="button" data-prompt="filter" aria-pressed="false">Filter production</button>
							<button type="button" data-prompt="approval" aria-pressed="false">Prepare approval</button>
						</div>
						<div class="demo-utilities">
							<button type="button" data-replay><span class="icon" set:html={icon('sync', 13)} /> Replay</button>
							<button type="button" data-reset>Reset</button>
						</div>
						<p class="demo-status" data-demo-status role="status" aria-live="polite">Choose a prompt to change the session HTML and its live panel.</p>
					</div>
				</div>
			</section>

			<section class="principles" aria-label="How Reindr works">
				<article>
					<span class="number">01</span>
					<div><h2>Plain HTML is the contract</h2><p>No component schema and no rendering DSL. The agent edits one normal HTML file with the same filesystem tools it already uses, and a write becomes a live update.</p></div>
				</article>
				<article>
					<span class="number">02</span>
					<div><h2>Every session keeps its own canvas</h2><p>The file follows the agent session, not the working directory. Resume the session elsewhere and the interface comes back; switch sessions and the panel follows.</p></div>
				</article>
				<article>
					<span class="number">03</span>
					<div><h2>The interface can answer back</h2><p>A trusted click can send structured choices to the owning session. Generated code stays sandboxed, receives no raw SDK, and cannot reach another session.</p></div>
				</article>
			</section>

			<section class="install" id="install" aria-labelledby="install-title">
				<div class="section-head">
					<p class="eyebrow"><span></span> Pick your host</p>
					<h2 id="install-title">Install the adapter. Ask for an interface.</h2>
					<p>Both integrations use the same local, file-backed canvas model. OpenCode installs from npm; Claude Code installs from the repository marketplace.</p>
				</div>
				<div class="install-grid">
					<article>
						<div class="install-label"><span class="icon" set:html={icon('package', 15)} /> OpenCode</div>
						<h3>Published npm adapter</h3>
						<pre><code>&lbrace;
  "plugin": ["@nicodes/reindr-opencode"]
&rbrace;</code></pre>
						<a href={npmPackage}>View @nicodes/reindr-opencode <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
					</article>
					<article>
						<div class="install-label"><span class="icon" set:html={icon('terminal', 15)} /> Claude Code</div>
						<h3>Repository marketplace plugin</h3>
						<pre><code>/plugin marketplace add nicodes/reindr
/plugin install reindr@nicodes</code></pre>
						<a href={`${docs}#install-for-claude-code`}>Read the Claude Code setup <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
					</article>
				</div>
			</section>

			<section class="workflow" aria-label="The Reindr workflow">
				<div class="section-head">
					<p class="eyebrow"><span></span> One file, live</p>
					<h2>The agent already knows how to build it.</h2>
					<p>
						Ask for a dashboard, a comparison table, or a form. Reindr opens the canvas immediately,
						then stays out of the authoring path. HTML, CSS, and JavaScript remain readable, editable,
						and local to your machine.
					</p>
				</div>

				<div class="code-frame">
					<div class="frame-bar dark-bar">
						<div class="frame-brand"><span class="menu-lines"></span> ~/.local/share/reindr/sessions/session.html</div>
						<div class="frame-actions"><span class="icon" set:html={icon('code-square', 13)} /><span class="icon" set:html={icon('file-code', 13)} /></div>
					</div>
					<div class="code-grid">
						<pre><span class="line">01</span> <span class="tag">&lt;form</span> <span class="attr">id</span>=<span class="str">"release"</span><span class="tag">&gt;</span>
<span class="line">02</span>   <span class="tag">&lt;label&gt;</span>Environment
<span class="line">03</span>     <span class="tag">&lt;select</span> <span class="attr">name</span>=<span class="str">"target"</span><span class="tag">&gt;</span>...<span class="tag">&lt;/select&gt;</span>
<span class="line">04</span>   <span class="tag">&lt;/label&gt;</span>
<span class="line">05</span>   <span class="tag">&lt;button&gt;</span>Deploy<span class="tag">&lt;/button&gt;</span>
<span class="line">06</span> <span class="tag">&lt;/form&gt;</span>
<span class="line">07</span>
<span class="line">08</span> <span class="kw">release</span>.onsubmit = (<span class="arg">event</span>) =&gt; &lbrace;
<span class="line">09</span>   event.preventDefault()
<span class="line">10</span>   opencode.submit(&lbrace;
<span class="line">11</span>     prompt: <span class="str">"Deploy this release"</span>,
<span class="line">12</span>     data: &lbrace; target: release.target.value &rbrace;
<span class="line">13</span>   &rbrace;)
<span class="line">14</span> &rbrace;</pre>
						<div class="bridge-summary">
							<div><span class="icon" set:html={icon('file-code', 17)} /><p><b>Editable file</b><small>Normal tools write normal HTML.</small></p></div>
							<i></i>
							<div><span class="icon" set:html={icon('browser', 17)} /><p><b>Sandboxed panel</b><small>Changes appear without a rebuild.</small></p></div>
							<i></i>
							<div><span class="icon" set:html={icon('reply', 17)} /><p><b>Scoped interaction</b><small>A click returns to its own session.</small></p></div>
						</div>
					</div>
				</div>
			</section>

			<section class="closing">
				<p>Ask for an interface.<br />Keep working in it.</p>
				<div class="chain"><span>YOUR PROMPT</span><i></i><span>SESSION HTML</span><i></i><span>LIVE PANEL</span></div>
				<div class="closing-actions">
					<a class="primary-cta light" href="#install">Get Reindr <span class="icon" set:html={icon('arrow-right', 16)} /></a>
					<a class="ghost-cta" href={docs}>Read the docs <span class="icon" set:html={icon('arrow-up-right', 14)} /></a>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand footer-brand" href="/"><span>reindr</span></a>
			<p><a href={repo}>source</a> / <a href={docs}>docs</a> / <a href={npmPackage}>npm</a></p>
			<p>&copy; {new Date().getFullYear()} reindr</p>
		</footer>
	</div>
</Layout>

<script>
	type DemoState = 'initial' | 'highlight' | 'filter' | 'approval';

	const demo = document.querySelector<HTMLElement>('[data-demo]');

	if (demo) {
		const states: Record<DemoState, {
			title: string;
			passed: string;
			failed: string;
			duration: string;
			action: string;
			noteTitle: string;
			noteCopy: string;
			patch: string;
			failedTests: number[];
		}> = {
			initial: {
				title: 'Ready when the red is gone.',
				passed: '47',
				failed: '2',
				duration: '8.4s',
				action: 'Ask agent to fix',
				noteTitle: 'Send to agent',
				noteCopy: 'Fix the two failing tests, then rerun this dashboard.',
				patch: '',
				failedTests: [2, 3],
			},
			highlight: {
				title: 'Two blockers, clearly surfaced.',
				passed: '47',
				failed: '2',
				duration: '8.4s',
				action: 'Send blockers',
				noteTitle: 'UI changed',
				noteCopy: 'Failures are grouped and emphasized in the live panel.',
				patch: '+ .failed { border-left: 3px solid #d8665d; }',
				failedTests: [2, 3],
			},
			filter: {
				title: 'Production checks, isolated.',
				passed: '31',
				failed: '1',
				duration: '5.1s',
				action: 'Run production',
				noteTitle: 'Filter added',
				noteCopy: 'The panel now separates production from staging results.',
				patch: '+ <nav aria-label="Environment">...</nav>',
				failedTests: [2, 3],
			},
			approval: {
				title: 'Production is ready to ship.',
				passed: '49',
				failed: '0',
				duration: '8.7s',
				action: 'Approve release',
				noteTitle: 'Ready for input',
				noteCopy: 'Approve to return this decision to the release-check session.',
				patch: '+ <button data-submit="approve">Approve release</button>',
				failedTests: [],
			},
		};

		const title = demo.querySelector<HTMLElement>('[data-demo-title]');
		const updated = demo.querySelector<HTMLElement>('[data-demo-updated]');
		const patch = demo.querySelector<HTMLElement>('[data-demo-patch]');
		const status = demo.querySelector<HTMLElement>('[data-demo-status]');
		const panelAction = demo.querySelector<HTMLButtonElement>('[data-panel-action]');
		const noteTitle = demo.querySelector<HTMLElement>('[data-note-title]');
		const noteCopy = demo.querySelector<HTMLElement>('[data-note-copy]');
		const filterBar = demo.querySelector<HTMLElement>('[data-filter-bar]');
		const metrics = new Map(
			Array.from(demo.querySelectorAll<HTMLElement>('[data-metric]')).map((metric) => [metric.dataset.metric, metric]),
		);
		const promptButtons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-prompt]'));
		const environmentButtons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-environment]'));
		const testRows = Array.from(demo.querySelectorAll<HTMLElement>('[data-test]'));
		const replay = demo.querySelector<HTMLButtonElement>('[data-replay]');
		const reset = demo.querySelector<HTMLButtonElement>('[data-reset]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let currentState: DemoState = 'initial';
		let runId = 0;

		const wait = (milliseconds: number, id: number) => new Promise<boolean>((resolve) => {
			window.setTimeout(() => resolve(id === runId), reduceMotion.matches ? 0 : milliseconds);
		});

		const setBusy = (busy: boolean) => {
			promptButtons.forEach((button) => { button.disabled = busy; });
			if (replay) replay.disabled = busy;
			if (panelAction) panelAction.disabled = busy;
		};

		const applyEnvironment = (environment: 'all' | 'production') => {
			environmentButtons.forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.environment === environment));
			});
			testRows.forEach((row) => {
				row.hidden = environment === 'production' && row.dataset.environmentRow !== 'production';
			});

			if (currentState !== 'filter') return;
			if (environment === 'all') {
				if (title) title.textContent = 'All environments, one view.';
				if (metrics.get('passed')) metrics.get('passed')!.textContent = '47';
				if (metrics.get('failed')) metrics.get('failed')!.textContent = '2';
				if (metrics.get('duration')) metrics.get('duration')!.textContent = '8.4s';
			} else {
				if (title) title.textContent = states.filter.title;
				if (metrics.get('passed')) metrics.get('passed')!.textContent = states.filter.passed;
				if (metrics.get('failed')) metrics.get('failed')!.textContent = states.filter.failed;
				if (metrics.get('duration')) metrics.get('duration')!.textContent = states.filter.duration;
			}
		};

		const applyState = (stateName: DemoState) => {
			const state = states[stateName];
			currentState = stateName;
			demo.dataset.state = stateName;
			delete demo.dataset.sent;
			if (title) title.textContent = state.title;
			if (updated) updated.textContent = stateName === 'initial' ? 'waiting for a prompt' : 'updated just now';
			if (panelAction) panelAction.textContent = state.action;
			if (noteTitle) noteTitle.textContent = state.noteTitle;
			if (noteCopy) noteCopy.textContent = state.noteCopy;
			if (metrics.get('passed')) metrics.get('passed')!.textContent = state.passed;
			if (metrics.get('failed')) metrics.get('failed')!.textContent = state.failed;
			if (metrics.get('duration')) metrics.get('duration')!.textContent = state.duration;
			if (filterBar) filterBar.hidden = stateName !== 'filter';
			promptButtons.forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.prompt === stateName));
			});
			testRows.forEach((row) => {
				const index = Number(row.dataset.test);
				const failed = state.failedTests.includes(index);
				row.hidden = false;
				row.classList.toggle('failed', failed);
				const check = row.querySelector<HTMLElement>('.check');
				check?.classList.toggle('bad', failed);
				check?.classList.toggle('good', !failed);
			});
			if (stateName === 'filter') applyEnvironment('production');
		};

		const transitionTo = async (stateName: Exclude<DemoState, 'initial'>, id: number) => {
			const state = states[stateName];
			demo.dataset.phase = 'writing';
			if (patch) patch.textContent = state.patch;
			if (status) status.textContent = `Agent is editing release-gate.html: ${stateName} requested.`;
			if (!(await wait(560, id))) return false;

			applyState(stateName);
			demo.dataset.phase = 'rendering';
			if (status) status.textContent = `Live panel updated: ${state.noteCopy}`;
			if (!(await wait(360, id))) return false;

			demo.dataset.phase = 'idle';
			return true;
		};

		const runState = async (stateName: Exclude<DemoState, 'initial'>) => {
			const id = ++runId;
			setBusy(true);
			await transitionTo(stateName, id);
			if (id === runId) setBusy(false);
		};

		promptButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const stateName = button.dataset.prompt as Exclude<DemoState, 'initial'>;
				void runState(stateName);
			});
		});

		environmentButtons.forEach((button) => {
			button.addEventListener('click', () => {
				applyEnvironment(button.dataset.environment as 'all' | 'production');
				if (status) status.textContent = `Dashboard filtered to ${button.textContent?.trim().toLowerCase()} checks.`;
			});
		});

		panelAction?.addEventListener('click', () => {
			if (currentState === 'initial') {
				void runState('highlight');
				return;
			}
			demo.dataset.sent = 'true';
			panelAction.textContent = currentState === 'approval' ? 'Approval sent' : 'Sent to session';
			if (noteTitle) noteTitle.textContent = 'Sent to session';
			if (noteCopy) noteCopy.textContent = currentState === 'approval'
				? 'Production approval returned to the release-check session.'
				: 'Structured dashboard context returned to the owning session.';
			if (status) status.textContent = noteCopy?.textContent ?? 'Panel response sent to the session.';
		});

		replay?.addEventListener('click', async () => {
			const id = ++runId;
			applyState('initial');
			setBusy(true);
			for (const stateName of ['highlight', 'filter', 'approval'] as const) {
				if (!(await transitionTo(stateName, id))) return;
				if (!(await wait(720, id))) return;
			}
			if (id === runId) setBusy(false);
		});

		reset?.addEventListener('click', () => {
			runId += 1;
			applyState('initial');
			demo.dataset.phase = 'idle';
			if (status) status.textContent = 'Choose a prompt to change the session HTML and its live panel.';
			setBusy(false);
		});

		if ('IntersectionObserver' in window) {
			const observer = new IntersectionObserver(([entry]) => {
				if (!entry?.isIntersecting && demo.dataset.phase !== 'idle') {
					runId += 1;
					demo.dataset.phase = 'idle';
					setBusy(false);
					if (status) status.textContent = 'Demo paused. Choose a prompt to continue.';
				}
			}, { threshold: 0.15 });
			observer.observe(demo);
		}
	}
</script>

<style>
	.page-shell { width: 100%; min-height: 100svh; overflow-x: hidden; }
	.site-header { width: min(1180px, calc(100% - 40px)); height: 76px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 19px; font-weight: 760; letter-spacing: -.03em; text-decoration: none; }
	.brand-mark { width: 28px; height: 28px; }
	.mark-shell { fill: var(--ink); }
	.mark-lines { fill: none; stroke: var(--mint); stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
	.header-cta { display: inline-flex; align-items: center; color: var(--ink); border-bottom: 1px solid #c5cbc7; padding: 6px 0; font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; }
	.header-cta span { margin-left: 5px; color: var(--mint-dark); }
	:global(.icon svg) { display: block; fill: currentColor; }

	.hero { width: min(1180px, calc(100% - 40px)); margin: 70px auto 110px; display: grid; grid-template-columns: .84fr 1.16fr; align-items: center; gap: 68px; }
	.hero-copy { position: relative; z-index: 2; min-width: 0; }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; color: var(--quiet); font: 620 11px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
	.eyebrow > span { width: 7px; height: 7px; border-radius: 50%; background: var(--mint-dark); box-shadow: 0 0 0 4px rgba(33, 122, 89, .12); }
	h1 { max-width: 610px; margin: 0; color: var(--ink); font-size: clamp(46px, 5.8vw, 78px); font-weight: 590; line-height: .98; letter-spacing: -.062em; }
	h1 em { display: block; color: var(--mint-dark); font-family: Georgia, serif; font-weight: 400; }
	.lede { max-width: 530px; margin: 30px 0 32px; color: var(--quiet); font-size: 16px; line-height: 1.7; }
	.hero-actions { display: flex; align-items: center; gap: 20px; }
	.hero-actions p { margin: 0; color: #818984; font: 500 10px/1.4 var(--mono); text-transform: uppercase; letter-spacing: .05em; }
	.primary-cta { display: inline-flex; align-items: center; gap: 30px; border-radius: 4px; background: var(--ink); color: white; padding: 14px 18px; font: 680 13px var(--sans); text-decoration: none; transition: transform .18s ease, background .18s ease; }
	.primary-cta:hover { transform: translateY(-2px); background: #26302d; }
	.primary-cta span { color: var(--mint); }

	.hero-demo { min-width: 690px; }
	.product-frame { position: relative; min-width: 0; border: 1px solid #cfd6d2; border-radius: 9px; background: white; box-shadow: 0 35px 80px rgba(18, 35, 29, .14), 0 3px 10px rgba(18, 35, 29, .07); overflow: hidden; transform: perspective(1400px) rotateY(-3deg) rotateX(1deg); }
